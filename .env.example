# Google Gemini configuration
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_FLASH_MODEL=gemini-3.6-flash
DEFAULT_PRO_MODEL=gemini-3.6-flash
GENERATION_FALLBACK_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# LLM Gateway & Groq configuration
# Provider preference: auto (default), groq, or gemini
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_REQUEST_TIMEOUT_S=60.0
LLM_FIRST_CONTENT_TIMEOUT_S=15.0
LLM_MAX_OUTPUT_TOKENS=4096
GROQ_CONNECT_TIMEOUT_S=5.0
GROQ_READ_TIMEOUT_S=60.0

# Generation retry configuration
GENERATION_MAX_RETRIES=3
GENERATION_BACKOFF_BASE_S=1.0
GENERATION_BACKOFF_MAX_S=8.0
GENERATION_RETRY_DEADLINE_S=30.0

# Backend and storage limits
PORT=8080
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=50
MAX_EXTRACTED_SIZE_MB=250
MAX_ARCHIVE_FILES=10000
MAX_SOURCE_FILE_SIZE_MB=5
MAX_IMAGE_SIZE_MB=10
GITHUB_CLONE_TIMEOUT_SECONDS=120

# Comma-separated browser origins allowed during local development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002

# Optional separate frontend development server target.
NEXT_PUBLIC_API_URL=http://localhost:8080
